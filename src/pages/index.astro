---
// The package list: every item from src/content/items, grouped by category.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { CATEGORIES, type Category } from '../consts';
import headerFlag from '../assets/header-flag.webp';
import headerEagle from '../assets/header-eagle.webp';

const items = (await getCollection('items')).sort((a, b) => a.data.order - b.data.order);
const groups = (Object.keys(CATEGORIES) as Category[])
	.map((key) => ({ key, label: CATEGORIES[key], items: items.filter((i) => i.data.category === key) }))
	.filter((g) => g.items.length > 0);
const confirmed = items.filter((i) => i.data.status === 'confirmed').length;
const ideas = items.length - confirmed;
---
<Base
	title="Patriot Package — an American heritage gift"
	description="A gift package for America's 250th: founding documents, history, coins and keepsakes."
>
	<div class="banner-wrap">
		<Image
			src={headerFlag}
			alt=""
			widths={[800, 1400, 2000]}
			sizes="100vw"
			loading="eager"
			class="banner-flag"
		/>
		<Image
			src={headerEagle}
			alt="A bald eagle flying straight at the viewer, wings spread wide, in front of the American flag"
			widths={[360, 720, 1440]}
			sizes="(max-width: 600px) 360px, 640px"
			loading="eager"
			fetchpriority="high"
			class="banner"
		/>
	</div>
	<header class="hero wrap">
		<p class="eyebrow">1776 – 2026</p>
		<h1>Patriot Package</h1>
		<p class="lede">A gift package for America's 250th: founding documents, history, coins and keepsakes.</p>
		<p class="count" data-testid="count">
			<strong>{confirmed} {confirmed === 1 ? 'item is' : 'items are'} in the package.</strong>
			{ideas > 0 && <>{' '}{ideas} more {ideas === 1 ? 'is an idea' : 'are ideas'} still being decided, each marked <span class="badge">Idea</span>.</>}
		</p>
	</header>
	<nav class="jump" aria-label="Categories">
		<ul class="wrap">
			{groups.map((g) => (
				<li><a href={`#h-${g.key}`}>{g.label} <span class="n">{g.items.length}</span></a></li>
			))}
		</ul>
	</nav>
	<main class="wrap">
		{groups.map((g) => (
			<section aria-labelledby={`h-${g.key}`}>
				<h2 id={`h-${g.key}`}>{g.label}</h2>
				<ul class="items">
					{g.items.map(async (item) => {
						const { Content } = await render(item);
						return (
							<li class:list={['item', { 'has-image': item.data.image || item.data.imageUrl }]} data-item={item.id} data-status={item.data.status}>
								{item.data.imageUrl && (
									// The seller's photo, from their CDN: <Image> would copy it onto this site (DECISIONS #13).
									<img
										src={`${item.data.imageUrl}&width=800`}
										srcset={`${item.data.imageUrl}&width=400 400w, ${item.data.imageUrl}&width=800 800w`}
										sizes="(max-width: 600px) 100vw, 200px"
										alt={item.data.imageAlt!}
										width="800"
										height="600"
										loading="lazy"
										decoding="async"
										referrerpolicy="no-referrer"
										class="photo"
									/>
								)}
								{item.data.image && (
									<Image
										src={item.data.image}
										alt={item.data.imageAlt!}
										widths={[400, 800]}
										sizes="(max-width: 600px) 100vw, 200px"
										class="photo"
									/>
								)}
								<div class="item-text">
									<div class="item-head">
										{item.data.status === 'speculative' && <span class="badge" aria-label="Idea, not yet decided">Idea</span>}
										<h3>{item.data.title}</h3>
										{item.data.byline && <p class="byline">{item.data.byline}</p>}
									</div>
									<div class="item-body"><Content /></div>
									{(item.data.priceUsd || item.data.link) && (
										<p class="meta">
											{item.data.priceUsd && <span>${item.data.priceUsd}</span>}
											{item.data.link && <a href={item.data.link.url} rel="noopener" class="more">{item.data.link.label}</a>}
											{item.data.about && <a href={item.data.about.url} rel="noopener" class="more">{item.data.about.label}</a>}
										</p>
									)}
								</div>
							</li>
						);
					})}
				</ul>
			</section>
		))}
	</main>
</Base>
