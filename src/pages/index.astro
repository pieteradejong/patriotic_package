---
// The package list: every item from src/content/items, grouped by category.
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { CATEGORIES, type Category } from '../consts';
import eagle from '../assets/eagle.webp';

const items = (await getCollection('items')).sort((a, b) => a.data.order - b.data.order);
const groups = (Object.keys(CATEGORIES) as Category[])
	.map((key) => ({ key, label: CATEGORIES[key], items: items.filter((i) => i.data.category === key) }))
	.filter((g) => g.items.length > 0);
const confirmed = items.filter((i) => i.data.status === 'confirmed').length;
---
<Base
	title="Patriot Package — an American heritage gift"
	description="A gift package for America's 250th: founding documents, history, coins and keepsakes."
>
	<header class="hero wrap">
		<div class="hero-top">
			<Image src={eagle} alt="A bald eagle" width={160} height={160} class="eagle" loading="eager" />
			<div>
				<p class="eyebrow">1776 – 2026</p>
				<h1>Patriot Package</h1>
			</div>
		</div>
		<p class="lede">A gift package for America's 250th: founding documents, history, coins and keepsakes.</p>
		<p class="count">{confirmed} items confirmed · {items.length - confirmed} under consideration</p>
	</header>
	<nav class="jump" aria-label="Categories">
		<ul class="wrap">
			{groups.map((g) => (
				<li><a href={`#h-${g.key}`}>{g.label} <span class="n">{g.items.length}</span></a></li>
			))}
		</ul>
	</nav>
	<main class="wrap">
		{groups.map((g) => (
			<section aria-labelledby={`h-${g.key}`}>
				<h2 id={`h-${g.key}`}>{g.label}</h2>
				<ul class="items">
					{g.items.map(async (item) => {
						const { Content } = await render(item);
						return (
							<li class:list={['item', { 'has-image': item.data.image }]} data-item={item.id} data-status={item.data.status}>
								{item.data.image && (
									<Image
										src={item.data.image}
										alt={item.data.imageAlt!}
										widths={[400, 800]}
										sizes="(max-width: 600px) 100vw, 200px"
										class="photo"
									/>
								)}
								<div class="item-text">
									<div class="item-head">
										{item.data.status === 'speculative' && <span class="badge" aria-label="Idea, not yet decided">Idea</span>}
										<h3>{item.data.title}</h3>
									</div>
									<div class="item-body"><Content /></div>
									{(item.data.priceUsd || item.data.link) && (
										<p class="meta">
											{item.data.priceUsd && <span>${item.data.priceUsd}</span>}
											{item.data.link && <a href={item.data.link.url} rel="noopener" class="more">{item.data.link.label}</a>}
										</p>
									)}
								</div>
							</li>
						);
					})}
				</ul>
			</section>
		))}
	</main>
</Base>
